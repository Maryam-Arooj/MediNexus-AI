# MediNexus AI backend configuration.
# Copy this file to "backend/.env" and replace EVERY placeholder. Never commit backend/.env.

# PostgreSQL connection (Windows default user is usually "postgres").
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@localhost:5432/smartcare

PORT=3001
NODE_ENV=development

# Random secret, at least 32 characters. Generate one in PowerShell with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=8h

# Comma-separated list of frontend origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Login/register attempts allowed per IP per window.
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MS=900000

# ── Demo doctor (used by: npm run doctor:provision) ───────────────────────────
# Set your OWN values locally. Password: 12+ characters with letters and numbers.
DEMO_DOCTOR_EMAIL=doctor@example.com
DEMO_DOCTOR_PASSWORD=change-me
DEMO_DOCTOR_NAME=Dr. Demo Doctor
# Optional real CNIC (13 digits). Leave empty to use a reserved placeholder.
DEMO_DOCTOR_CNIC=

# Only for a deliberate, verified real doctor on a production server.
ALLOW_DOCTOR_PROVISIONING_IN_PRODUCTION=false

# ── AI features (Google Gemini, free tier) ─────────────────────────────────────
# Get a key at https://aistudio.google.com/apikey and paste it here (never commit it).
# Leave empty to switch every AI feature off — the app keeps working without AI.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Used automatically when the main model is busy/rate-limited. Leave empty to disable.
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
# Max total time (ms) for one AI request across all attempts (main → fallback → main).
GEMINI_TOTAL_BUDGET_MS=45000
# AI requests allowed per user per window (protects your free quota).
AI_RATE_LIMIT_MAX=30
AI_RATE_LIMIT_WINDOW_MS=600000
